# 应用配置
APP_NAME=SuperBizAgent
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=9900

# DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# 运行时聊天模型
LLM_PROVIDER=xiaomi
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Xiaomi MiMo
XIAOMI_API_KEY=
XIAOMI_API_BASE=https://api.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2-flash

# AIOps 自动诊断
AIOPS_AUTO_DIAGNOSIS_ENABLED=True

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG
RAG_TOP_K=3
RAG_MODEL=qwen-max
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP Server
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
MCP_REMEDIATION_TRANSPORT=streamable-http
MCP_REMEDIATION_URL=http://localhost:8005/mcp

# Observability
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
DEMO_SERVICE_URL=http://localhost:9910

