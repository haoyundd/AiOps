APP_NAME=AIOps Incident Agent
ENVIRONMENT=local
DEBUG=false
HOST=0.0.0.0
PORT=9900

# Generate unique values before the first Compose start. No working password is
# committed to the repository.
POSTGRES_PASSWORD=
AIOPS_POSTGRES_HOST_PORT=5432
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ALERTMANAGER_WEBHOOK_SECRET=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
CORS_ORIGINS=["http://localhost:9900"]

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
LLM_PROVIDER=dashscope
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

AIOPS_AUTO_DIAGNOSIS_ENABLED=true
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
MERCHANTFLOW_HEALTH_URL=http://localhost:8081/actuator/health

# Mutations are rejected unless both switches are true. Use only with the
# isolated lab profile, never with a real target.
LAB_MODE=false
ALLOW_MUTATIONS=false
TOXIPROXY_URL=http://localhost:8474
